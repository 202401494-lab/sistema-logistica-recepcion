  <diagram id="pg-asis" name="BPMN As-Is">
    <mxGraphModel dx="1512" dy="765" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a-2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" value="BPMN – Proceso actual (As-Is): recepción y asignación manual de bahías" vertex="1">
          <mxGeometry height="20" width="1000" x="20" y="2" as="geometry" />
        </mxCell>
        <mxCell id="a-3" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E8EEF4;swimlaneFillColor=#FFFFFF;strokeColor=#444444;startSize=30;fontStyle=1;fontSize=11;" value="Transportista / Proveedor" vertex="1">
