  <diagram id="pg-ishi" name="Ishikawa">
    <mxGraphModel dx="1682" dy="852" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="i-2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontStyle=1;" value="Diagrama de Ishikawa (causa y efecto) – problema que origina SumaControl" vertex="1">
          <mxGeometry height="26" width="1300" x="20" y="8" as="geometry" />
        </mxCell>
        <mxCell id="i-3" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="60" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-4" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="1180" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;strokeWidth=2;fontSize=15;fontStyle=1;arcSize=8;" value="PROBLEMA&lt;br&gt;Congestión, esperas y asignación manual&lt;br&gt;de bahías con baja trazabilidad en la&lt;br&gt;recepción de proveedores" vertex="1">
          <mxGeometry height="140" width="350" x="1190" y="350" as="geometry" />
        </mxCell>
        <mxCell id="i-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;strokeWidth=1.3;fontSize=15;fontStyle=1;arcSize=8;" value="Método" vertex="1">
          <mxGeometry height="36" width="300" x="60" y="50" as="geometry" />
        </mxCell>
        <mxCell id="i-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.3;fontSize=15;arcSize=8;align=left;spacingLeft=8;" value="• Asignación de bahía por criterio verbal, sin regla fija&lt;br&gt;• Sin tolerancia ni penalización para llegadas tardías&lt;br&gt;• Sin separación por tipo de carga (construcción y general)&lt;br&gt;• Cola de espera sin prioridad objetiva" vertex="1">
          <mxGeometry height="230" width="300" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="i-8" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="280" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;strokeWidth=1.3;fontSize=15;fontStyle=1;arcSize=8;" value="Personal" vertex="1">
          <mxGeometry height="36" width="300" x="420" y="50" as="geometry" />
        </mxCell>
        <mxCell id="i-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.3;fontSize=15;arcSize=8;align=left;spacingLeft=8;" value="• El proceso depende de la experiencia de cada operador&lt;br&gt;• Poca capacitación en el registro de llegadas&lt;br&gt;• Coordinación por mensajes informales&lt;br&gt;• Rotación del personal de garita" vertex="1">
          <mxGeometry height="230" width="300" x="420" y="100" as="geometry" />
        </mxCell>
        <mxCell id="i-11" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="640" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;strokeWidth=1.3;fontSize=15;fontStyle=1;arcSize=8;" value="Tecnología" vertex="1">
          <mxGeometry height="36" width="300" x="780" y="50" as="geometry" />
        </mxCell>
        <mxCell id="i-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.3;fontSize=15;arcSize=8;align=left;spacingLeft=8;" value="• Registro en papel u hojas de cálculo&lt;br&gt;• Sin visibilidad en tiempo real de las bahías&lt;br&gt;• Sin automatización de la cola ni reasignación&lt;br&gt;• Sistemas aislados, sin integración" vertex="1">
          <mxGeometry height="230" width="300" x="780" y="100" as="geometry" />
        </mxCell>
        <mxCell id="i-14" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="1000" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.3;fontSize=15;arcSize=8;align=left;spacingLeft=8;" value="• Sin registro único de citas y pedidos&lt;br&gt;• Duplicidad y errores de captura&lt;br&gt;• Sin bitácora auditable de operaciones&lt;br&gt;• Tiempos de descarga sin medir" vertex="1">
          <mxGeometry height="230" width="300" x="60" y="510" as="geometry" />
        </mxCell>
        <mxCell id="i-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;strokeWidth=1.3;fontSize=15;fontStyle=1;arcSize=8;" value="Datos e información" vertex="1">
          <mxGeometry height="36" width="300" x="60" y="752" as="geometry" />
        </mxCell>
        <mxCell id="i-17" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="280" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.3;fontSize=15;arcSize=8;align=left;spacingLeft=8;" value="• Cinco bahías con restricciones por tipo de carga&lt;br&gt;• Conectividad inestable en la garita&lt;br&gt;• Espacio limitado para camiones en espera" vertex="1">
          <mxGeometry height="230" width="300" x="420" y="510" as="geometry" />
        </mxCell>
        <mxCell id="i-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;strokeWidth=1.3;fontSize=15;fontStyle=1;arcSize=8;" value="Infraestructura y entorno" vertex="1">
          <mxGeometry height="36" width="300" x="420" y="752" as="geometry" />
        </mxCell>
        <mxCell id="i-20" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="640" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.3;fontSize=15;arcSize=8;align=left;spacingLeft=8;" value="• Sin indicadores de puntualidad ni de espera&lt;br&gt;• Sin reportes por proveedor&lt;br&gt;• Sin control de proveedores ausentes" vertex="1">
          <mxGeometry height="230" width="300" x="780" y="510" as="geometry" />
        </mxCell>
        <mxCell id="i-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;strokeWidth=1.3;fontSize=15;fontStyle=1;arcSize=8;" value="Medición y control" vertex="1">
          <mxGeometry height="36" width="300" x="780" y="752" as="geometry" />
        </mxCell>
        <mxCell id="i-23" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=none;fontSize=15;" value="" vertex="1">
          <mxGeometry height="4" width="4" x="1000" y="420" as="geometry" />
        </mxCell>
        <mxCell id="i-24" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontStyle=2;" value="Causas reconstruidas a partir del problema que atiende SumaControl; sustituir por las del Ishikawa original del equipo si ya existe." vertex="1">
          <mxGeometry height="30" width="1500" x="20" y="800" as="geometry" />
        </mxCell>
        <mxCell id="i-25" edge="1" parent="1" source="i-3" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=15;fontStyle=2;" target="i-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i-26" edge="1" parent="1" source="i-7" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=15;fontStyle=2;" target="i-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i-27" edge="1" parent="1" source="i-10" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=15;fontStyle=2;" target="i-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i-28" edge="1" parent="1" source="i-13" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=15;fontStyle=2;" target="i-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i-29" edge="1" parent="1" source="i-15" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=15;fontStyle=2;" target="i-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i-30" edge="1" parent="1" source="i-18" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=15;fontStyle=2;" target="i-20" value="">
