metry"/></mxCell><mxCell id="d-8" value="«artifact»&lt;br&gt;Next.js (cliente): vistas de gestión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="525" width="320" height="80" as="geometry"/></mxCell><mxCell id="d-9" value="«network»&lt;br&gt;LAN del centro&lt;br&gt;Switch, VLAN de garita y&lt;br&gt;punto de acceso Wi-Fi (GRE 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="220" height="170" as="geometry"/></mxCell><mxCell id="d-10" value="«server» Servidor API Express" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="330" height="400" as="geometry"/></mxCell><mxCell id="d-11" value="«execution environment»&lt;br&gt;Node.js + PM2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="290" height="70" as="geometry"/></mxCell><mxCell id="d-12" value="«artifact»&lt;br&gt;sumacontrol-api (Express: controladores y servicios)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="195" width="290" height="70" as="geometry"/></mxCell><mxCell id="d-13" value="«artifact»&lt;br&gt;motor-eda0 (cola Heap + Aging)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="280" width="290" height="70" as="geometry"/></mxCell><mxCell id="d-14" value="«artifact»&lt;br&gt;sumacontrol-ui (Next.js servido al navegador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="365" width="290" height="80" as="geometry"/></mxCell><mxCell id="d-15" value="«server» Servidor de Base de Datos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="270" height="400" as="geometry"/></mxCell><mxCell id="d-16" value="«execution environment»&lt;br&gt;MongoDB (mongod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="d-17" value="«artifact»&lt;br&gt;base de datos sumacontrol&lt;br&gt;10 colecciones con&lt;br&gt;validadores $jsonSchema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1225" y="195" width="240" height="100" as="geometry"/></mxCell><mxCell id="d-18" value="«artifact»&lt;br&gt;respaldos (mongodump diario)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1225" y="310" width="240" height="80" as="geometry"/></mxCell><mxCell id="d-19" value="Comunicación y protocolos&lt;br&gt;&lt;br&gt;• Navegador ↔ API Express: HTTP/REST con JSON sobre TCP/IP.&lt;br&gt;• El tablero de bahías y cola se actualiza por consulta periódica (polling) cada [N] segundos a GET /api/gateways y GET /api/cola; no se usan WebSockets.&lt;br&gt;• API ↔ base de datos: controlador de MongoDB (Mongoose) sobre TCP/IP, puerto 27017 por defecto.&lt;br&gt;• Si la API y MongoDB comparten una misma máquina, se representan como dos entornos de ejecución dentro de un mismo nodo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#444444;fontSize=9;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="640" height="170" as="geometry"/></mxCell><mxCell id="d-20" value="Wi-Fi / Ethernet" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="d-3" target="d-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d-21" value="Ethernet" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="d-6" target="d-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d-22" value="HTTP/REST (JSON)&lt;br&gt;sobre TCP/IP" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="d-9" target="d-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d-23" value="Protocolo de MongoDB&lt;br&gt;sobre TCP/IP · puerto 27017" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="d-10" target="d-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg-bd" name="Modelo de datos MongoDB"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m-2" value="Modelo de datos de MongoDB – colecciones, identificadores y referencias" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="26" as="geometry"/></mxCell><mxCell id="m-3" value="parametros&lt;br&gt;_id · PK&lt;br&gt;nombre · único&lt;br&gt;valor&lt;br&gt;actualizadoPor → usuarios.email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="98" as="geometry"/></mxCell><mxCell id="m-4" value="usuarios&lt;br&gt;_id · PK&lt;br&gt;email · único&lt;br&gt;rolUsuario · enum&lt;br&gt;hashPassword&lt;br&gt;activo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="300" height="114" as="geometry"/></mxCell><mxCell id="m-5" value="historial&lt;br&gt;_id · PK&lt;br&gt;usuario → usuarios.email&lt;br&gt;fechaHora&lt;br&gt;accion · entidad · referencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="300" height="98" as="geometry"/></mxCell><mxCell id="m-6" value="tipos_carga&lt;br&gt;_id · PK&lt;br&gt;codigo · único (general | construcción)&lt;br&gt;descripcion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="60" width="300" height="82" as="geometry"/></mxCell><mxCell id="m-7" value="proveedores&lt;br&gt;_id · PK&lt;br&gt;rucProveedor · único&lt;br&gt;razonSocial&lt;br&gt;categoria · enum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="98" as="geometry"/></mxCell><mxCell id="m-8" value="pedidos&lt;br&gt;_id · PK&lt;br&gt;codPedido · único&lt;br&gt;rucProveedor → proveedores&lt;br&gt;tipoCarga → tipos_carga.codigo&lt;br&gt;estadoPedido · enum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="300" height="114" as="geometry"/></mxCell><mxCell id="m-9" value="citas&lt;br&gt;_id · PK&lt;br&gt;idCita · único&lt;br&gt;codPedido → pedidos · único&lt;br&gt;fechaHoraProgramada&lt;br&gt;ventanaToleranciaMin · estadoCita" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="300" height="114" as="geometry"/></mxCell><mxCell id="m-10" value="gateways&lt;br&gt;_id · PK&lt;br&gt;idGateway · único (1 a 5)&lt;br&gt;tipoCargaPermitida → tipos_carga&lt;br&gt;estadoGateway · enum&lt;br&gt;esExclusivoConstruccion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="330" width="300" height="114" as="geometry"/></mxCell><mxCell id="m-11" value="registros_llegada&lt;br&gt;_id · PK&lt;br&gt;idRegistro · único&lt;br&gt;idCita → citas · único&lt;br&gt;clasificacionPuntualidad&lt;br&gt;penalizado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="610" width="300" height="114" as="geometry"/></mxCell><mxCell id="m-12" value="descargas&lt;br&gt;_id · PK&lt;br&gt;idDescarga · único&lt;br&gt;codPedido → pedidos&lt;br&gt;idRegistro → registros_llegada&lt;br&gt;idGateway → gateways&lt;br&gt;duracionMinutos (RN-11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="610" width="300" height="130" as="geometry"/></mxCell><mxCell id="m-13" value="Relaciones por referencia a claves de negocio (sin documentos embebidos). La cola de espera del motor EDA 0 (Heap) vive en memoria y se reconstruye desde los pedidos EN COLA; confirmar contra la implementación." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1400" height="36" as="geometry"/></mxCell><mxCell id="m-14" value="1 : 0..*&lt;br&gt;actualizadoPor" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-4" target="m-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-15" value="1 : 0..*&lt;br&gt;usuario" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-4" target="m-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-16" value="1 : 0..*" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-6" target="m-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-17" value="1 : 0..*&lt;br&gt;rucProveedor" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-7" target="m-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-18" value="1 : 1&lt;br&gt;codPedido" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-8" target="m-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-19" value="1 : 0..1&lt;br&gt;idCita" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-9" target="m-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-20" value="0..1 : 0..1&lt;br&gt;idRegistro" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-11" target="m-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-21" value="1 : 0..*&lt;br&gt;idGateway" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-10" target="m-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-22" value="1 : 0..*&lt;br&gt;codPedido" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="m-8" target="m-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="830"/><mxPoint x="1360" y="830"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg-sop" name="Escalamiento de soporte L1-L2-L3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s-2" value="Flujo de atención y escalamiento de soporte (L1, L2, L3)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="26" as="geometry"/></mxCell><mxCell id="s-3" value="Usuario final&lt;br&gt;Operador de garita o&lt;br&gt;Coordinador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="200" height="80" as="geometry"/></mxCell><mxCell id="s-4" value="L1 · Mesa de ayuda y garita&lt;br&gt;MDS 0 / Operador líder&lt;br&gt;Respuesta &amp;lt; 15 min · Solución &amp;lt; 30 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="270" y="85" width="260" height="110" as="geometry"/></mxCell><mxCell id="s-5" value="¿Resuelto&lt;br&gt;en L1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="85" width="150" height="110" as="geometry"/></mxCell><mxCell id="s-6" value="L2 · Infraestructura y redes&lt;br&gt;GSO 0 / GRE 1&lt;br&gt;Respuesta &amp;lt; 30 min · Solución &amp;lt; 2 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="85" width="260" height="110" as="geometry"/></mxCell><mxCell id="s-7" value="¿Causa en&lt;br&gt;el código?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="85" width="150" height="110" as="geometry"/></mxCell><mxCell id="s-8" value="L3 · Desarrollo&lt;br&gt;PON 0 / EDA 0&lt;br&gt;Respuesta &amp;lt; 1 h&lt;br&gt;Solución &amp;lt; 4 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1280" y="85" width="200" height="110" as="geometry"/></mxCell><mxCell id="s-9" value="Cierre del ticket&lt;br&gt;y registro en L1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="s-10" value="Resolver y cerrar&lt;br&gt;en L2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="s-11" value="Rama bugfix/ + pruebas Jest&lt;br&gt;Pull Request con Code Review&lt;br&gt;Hotfix y verificación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1250" y="300" width="230" height="110" as="geometry"/></mxCell><mxCell id="s-12" value="Severidad S1 (sistema caído o regla crítica violada)&lt;br&gt;Se atiende en paralelo: Plan de Rollback con RTO &amp;lt; 15 min&lt;br&gt;y registro manual contingente en garita" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="270" y="500" width="560" height="110" as="geometry"/></mxCell><mxCell id="s-13" value="Canales de reporte: ventanilla de garita, chat interno y ticket L1; alertas de monitoreo (PM2) hacia L2; GitHub Issues desde L2 hacia L3.&lt;br&gt;Cada escalamiento conserva el ticket y su evidencia; el SLA de la severidad prevalece sobre el del nivel." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="870" y="500" width="610" height="130" as="geometry"/></mxCell><mxCell id="s-14" value="reporta" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-3" target="s-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-4" target="s-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-16" value="Sí" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-5" target="s-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655" y="250"/></Array></mxGeometry></mxCell><mxCell id="s-17" value="No" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-5" target="s-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-18" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-6" target="s-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-19" value="No" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-7" target="s-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-20" value="Sí" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-7" target="s-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-21" value="" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-8" target="s-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-22" value="S1" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="s-4" target="s-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="300"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>