ht="90" as="geometry"/></mxCell><mxCell id="a-21" value="Las dependencias van solo hacia abajo: cada capa usa a la inferior y no conoce a la superior." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1400" height="24" as="geometry"/></mxCell><mxCell id="a-22" value="HTTP/REST (JSON) sobre TCP/IP · polling" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="a-3" target="a-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-23" value="llamadas a servicios y al motor EDA 0" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="a-7" target="a-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-24" value="consultas y escrituras por Mongoose" style="html=1;rounded=0;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="a-12" target="a-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg-comp" name="Diagrama de componentes UML"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c-2" value="Diagrama de componentes UML – SumaControl" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="26" as="geometry"/></mxCell><mxCell id="c-3" value="«component»&lt;br&gt;Aplicación Next.js&lt;br&gt;GaritaUI · Tablero ·&lt;br&gt;Vistas Coordinador/Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-4" value="«component»&lt;br&gt;API REST Express&lt;br&gt;rutas y middleware&lt;br&gt;JWT / rol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-5" value="«component»&lt;br&gt;Controladores&lt;br&gt;ControladorLlegadas ·&lt;br&gt;ControladorDescargas · otros" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-6" value="«component»&lt;br&gt;Servicios de dominio&lt;br&gt;Puntualidad · Gateway ·&lt;br&gt;Pedido · Descarga" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-7" value="«component»&lt;br&gt;Motor EDA 0&lt;br&gt;PriorityQueue (Heap) +&lt;br&gt;AgingEngine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1050" y="460" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-8" value="«component»&lt;br&gt;Acceso a datos&lt;br&gt;Modelos Mongoose +&lt;br&gt;validadores $jsonSchema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="460" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-9" value="«component»&lt;br&gt;MongoDB&lt;br&gt;base de datos sumacontrol&lt;br&gt;10 colecciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#444444;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="460" width="240" height="130" as="geometry"/></mxCell><mxCell id="c-10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="312" y="207" width="16" height="16" as="geometry"/></mxCell><mxCell id="c-11" value="IApiRest&lt;br&gt;(HTTP/JSON)" style="text;html=1;align=left;verticalAlign=top;fontSize=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="275" y="227" width="110" height="30" as="geometry"/></mxCell><mxCell id="c-12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="652" y="207" width="16" height="16" as="geometry"/></mxCell><mxCell id="c-13" value="IControladores" style="text;html=1;align=left;verticalAlign=top;fontSize=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="615" y="227" width="110" height="30" as="geometry"/></mxCell><mxCell id="c-14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="992" y="207" width="16" height="16" as="geometry"/></mxCell><mxCell id="c-15" value="IReglasNegocio" style="text;html=1;align=left;verticalAlign=top;fontSize=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="955" y="227" width="110" height="30" as="geometry"/></mxCell><mxCell id="c-16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1162" y="367" width="16" height="16" as="geometry"/></mxCell><mxCell id="c-17" value="IColaPrioridad" style="text;html=1;align=left;verticalAlign=top;fontSize=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1125" y="387" width="110" height="30" as="geometry"/></mxCell><mxCell id="c-18" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="992" y="322" width="16" height="16" as="geometry"/></mxCell><mxCell id="c-19" value="IRepositorio" style="text;html=1;align=left;verticalAlign=top;fontSize=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="955" y="342" width="110" height="30" as="geometry"/></mxCell><mxCell id="c-20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="652" y="517" width="16" height="16" as="geometry"/></mxCell><mxCell id="c-21" value="Protocolo MongoDB&lt;br&gt;(TCP/IP)" style="text;html=1;align=left;verticalAlign=top;fontSize=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="615" y="537" width="110" height="30" as="geometry"/></mxCell><mxCell id="c-22" value="Notación: «component» = componente; círculo = interfaz provista; flecha punteada = dependencia (el componente usa la interfaz).&lt;br&gt;Flujo principal: la aplicación Next.js consume IApiRest; los controladores invocan las reglas de negocio; las reglas usan el motor EDA 0 para la cola y el acceso a datos para persistir en MongoDB.&lt;br&gt;Correspondencia con las clases: ControladorLlegadas y ControladorDescargas (clases de apoyo S12); servicios y Motor EDA 0 (MotorAsignacionEDA0, Heap y Aging); modelos Mongoose ↔ colecciones de la sección 6." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#444444;fontSize=9;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="1260" height="120" as="geometry"/></mxCell><mxCell id="c-23" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-4" target="c-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-24" value="" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-3" target="c-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-25" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-5" target="c-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-26" value="" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-4" target="c-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-27" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-6" target="c-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-28" value="" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-5" target="c-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-29" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-7" target="c-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-30" value="" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-6" target="c-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-31" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-8" target="c-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-32" value="" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-6" target="c-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-33" value="" style="html=1;rounded=0;endArrow=none;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-9" target="c-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-34" value="" style="html=1;rounded=0;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c-8" target="c-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg-dep" name="Diagrama de 